          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "calopulse",
          "configurations": {
            "android": "1:601705661315:android:9db88f0bff11b064776cb6",
            "ios": "1:601705661315:ios:1f2823508d070f3b776cb6",
